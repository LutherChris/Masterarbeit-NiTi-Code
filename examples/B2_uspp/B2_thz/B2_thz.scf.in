&control
    calculation = 'scf'
    prefix = 'B2_thz'
    pseudo_dir = '../pseudo'
    outdir = '../tmp_B2_thz'
/
&system    
    ibrav = 1
    celldm(1) = 5.6127
    nat = 2
    ntyp = 2
    ecutwfc = 46
    occupations = 'smearing'
    smearing = 'methfessel-paxton'
    degauss = 0.01
/
&electrons
    conv_thr = 1.0d-8
/
ATOMIC_SPECIES
 Ni 58.6934 ni_pbesol_v1.4.uspp.F.UPF
 Ti 47.867  ti_pbesol_v1.4.uspp.F.UPF

ATOMIC_POSITIONS alat
 Ni 0.0 0.0 0.0
 Ti 0.5 0.5 0.5

K_POINTS automatic
 20 20 20 1 1 1
